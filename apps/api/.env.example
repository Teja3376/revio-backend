# Supabase Postgres (transaction pooler for queries, session pooler for migrations and pg-boss)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
# Verifies the dashboard's Supabase sign-in tokens
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# GitHub App (Settings → Developer settings → GitHub Apps)
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Gemini key used for pull request reviews
GEMINI_API_KEY=
PORT=4000
WEB_ORIGIN=http://localhost:3000
REVIO_DAILY_REVIEW_CAP=50

{
  "name": "@revio/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup",
    "start": "node dist/main.js",
    "dev": "tsup --watch --onSuccess 'node dist/main.js'",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "migration:run": "typeorm migration:run -d dist/data-source.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/swagger": "^12.0.5",
    "@octokit/app": "^16.1.4",
    "@octokit/webhooks-methods": "^6.0.0",
    "@revio/core": "workspace:*",
    "@revio/types": "workspace:*",
    "jose": "^6.2.14",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.3.2",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
